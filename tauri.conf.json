{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "门窗管理软件",
  "version": "0.1.0",
  "identifier": "com.example.doorwindow",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "门窗管理软件",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "鑫福门窗",
    "copyright": "Apache-2.0",
    "shortDescription": "门窗订单与下料管理（本地单机）",
    "longDescription": "门窗/移门门店与工厂用的本地单机管理软件：订单、客户、合同、下料计算、单据打印、备份恢复。数据全部保存在安装目录，不联网。",
    "resources": ["app-seed.db"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  }
}
